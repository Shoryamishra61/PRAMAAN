{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-result.schema.json",
  "title": "Dispute Integrity Gate evaluation result artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_schema_version",
    "run_id",
    "created_at",
    "system",
    "dataset",
    "predictions",
    "metrics"
  ],
  "properties": {
    "artifact_schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "system_version",
        "extractor_id",
        "model_id",
        "prompt_version",
        "claim_schema_version",
        "config_sha256",
        "code_commit"
      ],
      "properties": {
        "system_id": { "const": "dispute-integrity-gate" },
        "system_version": { "type": "string", "minLength": 1 },
        "extractor_id": { "type": "string", "minLength": 1 },
        "model_id": { "type": ["string", "null"] },
        "prompt_version": { "type": "string", "minLength": 1 },
        "claim_schema_version": { "type": "string", "minLength": 1 },
        "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "code_commit": { "type": "string", "minLength": 1 }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "generator_version",
        "split",
        "synthetic",
        "manifest_sha256"
      ],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "generator_version": { "type": "string", "minLength": 1 },
        "split": { "enum": ["dev", "holdout"] },
        "synthetic": { "type": "boolean" },
        "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/prediction" }
    },
    "metrics": { "type": "object" }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "quote", "start", "end", "normalized_value"],
      "properties": {
        "claim_type": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "normalized_value": {}
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "predicted_status",
        "expected_status",
        "finding_codes",
        "review_reasons",
        "predicted_claims",
        "expected_claims",
        "slice"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "predicted_status": { "enum": ["PASS", "REVIEW", "BLOCK"] },
        "expected_status": { "enum": ["PASS", "REVIEW", "BLOCK"] },
        "finding_codes": { "type": "array", "items": { "type": "string" } },
        "review_reasons": { "type": "array", "items": { "type": "string" } },
        "predicted_claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "expected_claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "slice": { "type": "string", "minLength": 1 }
      }
    }
  }
}
